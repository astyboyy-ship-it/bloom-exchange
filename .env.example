# Bloom Exchange node configuration. Copy to apps/node/.env.local for local development, or use deploy/.env
# (written by 
pm run sovereign:init) for Docker and Kubernetes. Nothing here is required for the sandbox.

# Ed25519 root key seed for BLOOM-XCH certificates and the HMAC operator seal. Without it a development key is
# derived (fine locally; certificates say so). 64 hex chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BLOOM_EXCHANGE_SECRET=""

# Signs and verifies Bloom access keys (BLOOMK-…). Issue keys with: npm run key:issue -- --role operator --holder "You"
# LICENSE_SIGNING_SECRET=""
# BLOOM_DEV_LICENSES="true"

# Shared state across instances (Upstash, or serverless-redis-http over your own Redis). Without it: in-memory, single instance.
# KV_REST_API_URL=""
# KV_REST_API_TOKEN=""

# Live models for the proposing engine (Sovereign clamps whatever they propose). Without them: deterministic simulation.
# ANTHROPIC_API_KEY=""
# OPENROUTER_API_KEY=""
# EXCHANGE_MODEL="claude-sonnet-5-5"
# BLOOM_DAILY_SPEND_CAP_USD="20"
# BLOOM_KEY_DAILY_SPEND_CAP_USD="5"

# Node identity and peers. A named node signs as "Bloom Exchange · <org>"; peers are other nodes' base URLs whose
# signed Agent Cards this node verifies at /api/exchange/peers.
# BLOOM_NODE_ORG="Acme Fund"
# BLOOM_PEERS="https://node.partner.example"

# Settlement delivery and public identity.
# BLOOM_EXCHANGE_SETTLEMENT_WEBHOOK_URL=""
# BLOOM_EXCHANGE_X402_PAYTO=""
# BLOOM_EXCHANGE_X402_NETWORK="base"
# The origin cards and receipts name this node by. Unset, each request's Host header is used, so a receipt records
# whatever host its client reached; production prints one warning, and /api/exchange/node reports "request-host".
# BLOOM_EXCHANGE_PUBLIC_URL=""
# Strict mode: refuse binding (production) negotiations until BLOOM_EXCHANGE_PUBLIC_URL is set. Sandbox is unaffected.
# BLOOM_EXCHANGE_REQUIRE_PUBLIC_URL="1"

# Event feed and post-event adapters (off by default; see docs/EVENTS.md).
# BLOOM_EVENTS="1"
# BLOOM_EVENTS_DIR="./data/events"
# BLOOM_EVENTS_JSONL="./data/audit.jsonl"
# BLOOM_EVENTS_WEBHOOK_URL="https://hooks.example.com/bloom"
# BLOOM_EVENTS_WEBHOOK_ALLOW="https://hooks.example.com"
# BLOOM_EVENTS_WEBHOOK_SECRET=""

# Bloom clearing relay. With none of these set it runs locally on http://127.0.0.1:8787 with an in-memory store.

# PORT=8787
# HOST=127.0.0.1
# NODE_ENV=production

# The relay's public origin, written into every room and receipt (https in production).
# RELAY_PUBLIC_URL=https://bloom-exchange-relay.vercel.app
# VERIFIER_URL=https://bloom-exchange-verify.vercel.app

# Required in production. Postgres or Supabase, migrated with supabase/migrations/001_phase2_relay.sql.
# DATABASE_URL=postgres://user:password@host:5432/bloom          (no sslmode=: TLS is set below)
# DATABASE_SSL=true                     # production default; certificates are always verified
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
#   Supabase: its Postgres certificate is signed by Supabase's own CA. Download it from the dashboard
#   (Project Settings > Database > SSL configuration) and set it here, e.g. fly secrets set DATABASE_SSL_CA="$(cat prod-ca-2021.crt)"

# Required in production: shared replay protection (SET NX EX 60 per nonce).
# UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=

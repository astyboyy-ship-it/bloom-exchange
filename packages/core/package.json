{
  "name": "@bloom-exchange/core",
  "version": "0.2.0",
  "description": "Reference engine for the Bloom Clearing Protocol: double-blind sealed commitments, Shield firewall, deterministic Sovereign clamping and Ed25519-signed BLOOM-XCH settlement certificates, with framework-agnostic HTTP handlers.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./events": {
      "types": "./dist/events/index.d.ts",
      "import": "./dist/events/index.js"
    },
    "./http/*": {
      "types": "./dist/http/*.d.ts",
      "import": "./dist/http/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/astyboyy-ship-it/bloom-exchange.git", "directory": "packages/core" },
  "homepage": "https://github.com/astyboyy-ship-it/bloom-exchange#readme",
  "bugs": { "url": "https://github.com/astyboyy-ship-it/bloom-exchange/issues" },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bloom-exchange/sdk": "^0.2.0"
  },
  "keywords": ["a2a", "ap2", "x402", "mcp", "agents", "agentic-commerce", "negotiation", "clearinghouse", "ed25519", "bloom"]
}
